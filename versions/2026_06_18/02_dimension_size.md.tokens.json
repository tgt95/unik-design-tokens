{
  "button": {
    "padding-left": {
      "$type": "dimension",
      "$value": "12px"
    },
    "padding-right": {
      "$type": "dimension",
      "$value": "12px"
    },
    "height": {
      "$type": "dimension",
      "$value": "{size.xl}"
    },
    "icon": {
      "size": {
        "$type": "dimension",
        "$value": "{size.3sm}"
      }
    },
    "gap": {
      "$type": "dimension",
      "$value": "{spacing.3xs}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.lg}"
    },
    "radius-focus-ring": {
      "$type": "dimension",
      "$value": "11px"
    },
    "font-size": {
      "$type": "dimension",
      "$value": "{font.size.base.md}"
    },
    "line-height": {
      "$type": "dimension",
      "$value": "{line-height.base.md}"
    },
    "font-weight": {
      "$type": "dimension",
      "$value": "{font.weight.semibold}"
    }
  }
}