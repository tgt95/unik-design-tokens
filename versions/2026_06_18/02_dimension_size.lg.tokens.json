{
  "button": {
    "padding-left": {
      "$type": "dimension",
      "$value": "16px"
    },
    "padding-right": {
      "$type": "dimension",
      "$value": "16px"
    },
    "height": {
      "$type": "dimension",
      "$value": "{size.2xl}"
    },
    "icon": {
      "size": {
        "$type": "dimension",
        "$value": "{size.2sm}"
      }
    },
    "gap": {
      "$type": "dimension",
      "$value": "{spacing.2xs}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.lg}"
    },
    "radius-focus-ring": {
      "$type": "dimension",
      "$value": "11px"
    },
    "font-size": {
      "$type": "dimension",
      "$value": "{font.size.base.lg}"
    },
    "line-height": {
      "$type": "dimension",
      "$value": "{line-height.base.lg}"
    },
    "font-weight": {
      "$type": "dimension",
      "$value": "{font.weight.semibold}"
    }
  }
}